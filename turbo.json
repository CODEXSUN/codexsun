{
  "$schema": "https://turbo.build/schema.json",
  "cacheDir": "dist/.turbo",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@codexsun/platform-api#build": {
      "outputs": ["../../../dist/platform/api/**"]
    },
    "@codexsun/platform-web#build": {
      "outputs": ["../../../dist/platform/web/**"]
    },
    "@codexsun/uiux-web#build": {
      "outputs": ["../../../dist/uiux/web/**"]
    },
    "check": {
      "dependsOn": ["^check"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  }
}
