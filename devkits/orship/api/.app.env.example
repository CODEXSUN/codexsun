PLATFORM_HOST=127.0.0.1
ORSHIP_API_PORT=6300
ORSHIP_WEB_ORIGIN=http://127.0.0.1:6301
ORSHIP_API_REFERENCE_TOKEN=change-this-local-token
ORSHIP_DOCKER_MANAGER_URL=http://127.0.0.1:6302
ORSHIP_DOCKER_TOKEN=orship-local-docker-token
ORSHIP_DOKPLOY_BASE_URL=https://dokploy.example.com/api
ORSHIP_DOKPLOY_ACCESS_TOKEN_REF=DOKPLOY_ACCESS_TOKEN
# Resolve this reference from the approved secret provider. Never commit the value.
DOKPLOY_ACCESS_TOKEN=change-this-provider-token
DATABASE_URL=mysql://root:change-this-root-password@orship-database:3306/orship_db
ORSHIP_MARIADB_CONTAINER_NAME=orship-database
ORSHIP_MARIADB_DATABASE=orship_db
ORSHIP_MARIADB_HOST_PORT=3309
ORSHIP_MARIADB_IMAGE=orship/mariadb:11.8
ORSHIP_MARIADB_NETWORK=codexsun-network
APP_MODE=development
AUTO_LOGIN=1
AUTO_LOGIN_DESK=user
REFRESH_IDENTITY_SEED=0
IDENTITY_LOGIN_MAX_FAILURES=5
IDENTITY_LOGIN_WINDOW_SECONDS=900
IDENTITY_LOGIN_LOCKOUT_SECONDS=900
IDENTITY_PASSWORD_RESET_TOKEN_TTL_SECONDS=900
IDENTITY_EXPOSE_DEVELOPMENT_RESET_TOKEN=0
PLATFORM_JWT_SECRET=change-this-to-a-32-character-minimum-secret
SUPER_ADMIN_NAME=super-admin
SUPER_ADMIN_LOGIN=superadmin@superadmin.com
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=change_pass
ADMIN_NAME=Admin
ADMIN_LOGIN=admin@changepass.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_pass
USER_NAME=User
USER_LOGIN=user@changepass.com
USER_USERNAME=user
USER_PASSWORD=change_pass
