# For remote previews set the bind host to 0.0.0.0 and the public host
# to the server IP or domain reachable from your browser.
ZCODE_PREVIEW_BIND_HOST=127.0.0.1
ZCODE_PREVIEW_PUBLIC_HOST=127.0.0.1
ZCODE_PREVIEW_PUBLIC_SCHEME=http
# Optional reverse proxy URL. {port} is the published preview port.
ZCODE_PREVIEW_URL_TEMPLATE=https://{port}.tmnext.in/
# For https://{port}.tmnext.in/ set this to .tmnext.in
ZCODE_PREVIEW_ALLOWED_HOST=.tmnext.in
