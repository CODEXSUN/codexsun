{
  "name": "@codexsun/sites-clients",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./codexsun": "./src/clients/codexsun/index.ts",
    "./logicx": "./src/clients/logicx/index.ts",
    "./techmedia": "./src/clients/techmedia/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build --mode codexsun && vite build --mode logicx && vite build --mode techmedia",
    "build:codexsun": "vite build --mode codexsun",
    "build:logicx": "vite build --mode logicx",
    "build:techmedia": "vite build --mode techmedia",
    "dev:codexsun": "vite --mode codexsun",
    "dev:logicx": "vite --mode logicx",
    "dev:techmedia": "vite --mode techmedia",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codexsun/ui": "^1.1.1",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.0.0"
  },
  "description": "Client public portfolio sites: CODEXSUN (7130), LogicX (7131), and TechMedia (7132)"
}
