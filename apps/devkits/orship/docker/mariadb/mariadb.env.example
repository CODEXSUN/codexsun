# Copy this file to an operator-controlled path and keep the real password out of git.
MARIADB_NAME=orship-mariadb
MARIADB_IMAGE=orship/mariadb:11.8
MARIADB_VERSION=11.8
MARIADB_NETWORK=codexsun-network
MARIADB_BIND_ADDRESS=127.0.0.1
MARIADB_HOST_PORT=3308
MARIADB_CONTAINER_PORT=3306
MARIADB_ROOT_PASSWORD=change-this-root-password
MARIADB_DATABASE=orship
MARIADB_DATA_VOLUME=orship-mariadb-data
MARIADB_BACKUP_VOLUME=orship-mariadb-backups
MARIADB_RESTART_POLICY=unless-stopped
MARIADB_BACKUP_DIR=./backups
MARIADB_BACKUP_RETENTION_DAYS=14
MARIADB_BACKUP_INTERVAL_SECONDS=86400
