{
  "name": "codexsun-tconnect",
  "account_id": "a68cf61bf5bae3f83ddb7765dc29a835",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-17",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "CODEXSUN_TCONNECT_API_ORIGIN": "https://codexsun.com",
    "CODEXSUN_TCONNECT_CORPORATE_ID": "TIRUPURCONNECT"
  },
  "routes": [
    { "pattern": "tirupurconnect.com/*", "zone_id": "d3cda9449945a79239fa7ab5f74bef09" },
    { "pattern": "www.tirupurconnect.com/*", "zone_id": "d3cda9449945a79239fa7ab5f74bef09" }
  ],
  "assets": {
    "directory": "../../../../dist/apps/tconnect/web",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
