{
  "name": "@codexsun/qcafe-api",
  "version": "1.0.36",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --banner:js=\"import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url); const __dirname = import.meta.dirname;\" --outfile=../../../dist/apps/qcafe/api/server.js",
    "build:deployment": "npm run build && esbuild src/deployment-prepare.ts --bundle --platform=node --format=esm --banner:js=\"import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url); const __dirname = import.meta.dirname;\" --outfile=../../../dist/apps/qcafe/api/deployment-prepare.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "database:migrate": "tsx src/database-migrate.ts",
    "database:smoke": "tsx src/database-smoke.ts",
    "database:verify": "tsx src/database-verify.ts",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src",
    "test": "tsx --test src/server.test.ts src/mariadb.integration.test.ts src/qcafe-provider-catalog.test.ts src/modules/foundation/test/provider.test.ts src/modules/foundation/test/qcafe-persistence.test.ts src/modules/foundation/test/qcafe-database-verifier.test.ts src/modules/foundation/test/foundation-setup.test.ts src/modules/menu/test/menu.service.test.ts src/modules/menu/test/menu-policy.service.test.ts src/modules/menu/test/menu-campaign.service.test.ts src/modules/pos/test/pos-kitchen-table.test.ts src/modules/billing/test/billing.service.test.ts src/modules/booking/test/guest-event.service.test.ts src/modules/settings/test/settings.service.test.ts"
  },
  "dependencies": {
    "@codexsun/framework": "file:../../../packages/framework",
    "@codexsun/platform-core": "file:../../../packages/platform-core",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "dotenv": "^17.0.0",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^4.0.2",
    "kysely": "^0.29.6",
    "zod": "^3.25.76"
  }
}
