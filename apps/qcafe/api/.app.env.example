PLATFORM_HOST=127.0.0.1
QCAFE_API_PORT=6202
QCAFE_WEB_ORIGIN=http://127.0.0.1:6203
QCAFE_API_REFERENCE_TOKEN=change-this-local-token
# Set DB_DRIVER=sqlite or DB_DRIVER=mariadb in the ignored repository .env file.
# MariaDB uses the shared DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, and DB_MASTER_NAME values.
QCAFE_SQLITE_PATH=../../../storage/apps/qcafe/private/data/qcafe.sqlite
QCAFE_IDENTITY_DATABASE_PATH=../../../storage/apps/qcafe/private/data/qcafe_db.sqlite
QCAFE_STORAGE_ROOT=../../../storage/apps
# Local mode may send queued changes to an approved cloud sync API.
# QCAFE_SYNC_CLOUD_URL=https://qcafe.example/api/v1/qcafe/sync
APP_MODE=development
AUTO_LOGIN=0
AUTO_LOGIN_DESK=user
REFRESH_IDENTITY_SEED=0
IDENTITY_LOGIN_MAX_FAILURES=5
IDENTITY_LOGIN_WINDOW_SECONDS=900
IDENTITY_LOGIN_LOCKOUT_SECONDS=900
IDENTITY_PASSWORD_RESET_TOKEN_TTL_SECONDS=900
IDENTITY_EXPOSE_DEVELOPMENT_RESET_TOKEN=0
PLATFORM_JWT_SECRET=change-this-to-a-32-character-minimum-secret
SUPER_ADMIN_NAME=super-admin
SUPER_ADMIN_LOGIN=superadmin@superadmin.com
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=change_pass
ADMIN_NAME=Admin
ADMIN_LOGIN=admin@changepass.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_pass
USER_NAME=User
USER_LOGIN=user@changepass.com
USER_USERNAME=user
USER_PASSWORD=change_pass
