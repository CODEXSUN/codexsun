{
  "name": "@codexsun/zetro-api",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test:connection": "node --test --import tsx tests/codex-app-server.client.test.ts",
    "test:history": "node --test --import tsx tests/chat-conversation.service.test.ts",
    "test:projects": "node --test --import tsx tests/project.service.test.ts",
    "test:tasks": "node --test --import tsx tests/tasks.service.test.ts",
    "test:workflow": "node --test --import tsx tests/codex-workflow.test.ts",
    "test:worktree": "node --test --import tsx tests/codex-worktree.service.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "start": "node ../../../dist/apps/zetro/api/server.js"
  },
  "dependencies": {
    "dotenv": "latest",
    "fastify": "^5.12.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
