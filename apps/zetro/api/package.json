{
  "name": "@codexsun/zetro-api",
  "private": true,
  "version": "0.1.27",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --cache --cache-location ../../../node_modules/.cache/eslint/zetro-api.eslintcache",
    "test": "npm run test:connection && npm run test:security && npm run test:system-tasks && npm run test:developer-tools && npm run test:git-delivery && npm run test:model-selection && npm run test:attachment-guidance && npm run test:history && npm run test:projects && npm run test:tasks && npm run test:workflow && npm run test:worktree",
    "test:connection": "node --test --import tsx tests/codex-app-server.client.test.ts",
    "test:security": "node --test --import tsx tests/desktop-session-auth.test.ts tests/supervisor.test.ts",
    "test:system-tasks": "node --test --import tsx tests/system-tasks.test.ts",
    "test:developer-tools": "node --test --import tsx tests/developer-tools.git.test.ts tests/developer-tools.scripts.test.ts",
    "test:git-delivery": "node --test --import tsx tests/git-delivery.service.test.ts",
    "test:model-selection": "node --test --import tsx tests/chat-model-selection.test.ts",
    "test:attachment-guidance": "node --test --import tsx tests/chat-attachment-guidance.test.ts",
    "test:chat-service": "node --test --import tsx tests/chat.service.test.ts",
    "test:history": "node --test --import tsx tests/chat-conversation.service.test.ts tests/chat.scope.test.ts tests/chat.scope-routes.test.ts",
    "test:projects": "node --test --import tsx tests/project.service.test.ts",
    "test:tasks": "node --test --import tsx tests/tasks.service.test.ts",
    "test:workflow": "node --test --import tsx tests/codex-workflow.test.ts",
    "test:worktree": "node --test --import tsx tests/codex-worktree.service.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "start": "node ../../../dist/apps/zetro/api/server.js"
  },
  "dependencies": {
    "@codexsun/platform-core-api": "^0.1.27",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.11.1",
    "bullmq": "^6.3.4",
    "fastify": "^5.12.1",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.5",
    "mysql2": "^3.23.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
