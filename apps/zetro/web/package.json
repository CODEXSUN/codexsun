{
  "name": "@codexsun/zetro-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 6060",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "lint": "eslint . --cache --cache-location ../../../node_modules/.cache/eslint/zetro-web.eslintcache",
    "test": "npm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "preview": "vite preview --port 6060"
  },
  "dependencies": {
    "@codexsun/ui": "file:../../../packages/ui",
    "@codexsun/zetro-contracts": "file:../contracts",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "^1.33.0",
    "mermaid": "^11.12.1",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "^4.3.3",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
