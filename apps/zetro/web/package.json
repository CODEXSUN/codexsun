{
  "name": "@codexsun/zetro-web",
  "private": true,
  "version": "0.1.23",
  "type": "module",
  "scripts": {
    "dev": "vite --port 6060",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "lint": "eslint . --cache --cache-location ../../../node_modules/.cache/eslint/zetro-web.eslintcache",
    "test": "npm run test:attachments && npm run test:automation && npm run test:markdown && npm run test:model-selection",
    "test:attachments": "node --test --import tsx tests/agent-chat.attachments.test.ts",
    "test:automation": "node --test --import tsx tests/automation.supervisor.test.ts",
    "test:markdown": "node --test --import tsx tests/agent-chat.markdown.test.tsx",
    "test:model-selection": "node --test --import tsx tests/agent-chat.model-selection.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "preview": "vite preview --port 6060"
  },
  "dependencies": {
    "@codexsun/ui": "file:../../../packages/ui",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "2.11.1",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "^1.33.0",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "^4.3.3",
    "tw-shimmer": "^0.4.12",
    "typescript": "latest",
    "vite": "latest",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
