{
  "compilerOptions": {
    "tsBuildInfoFile": "../../../node_modules/.cache/tsbuildinfo/devkit-web.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@codexsun/devkit-contracts": ["../contracts/src/index.ts"],
      "@codexsun/ui": ["../../../packages/ui/src/index.ts"]
    },
    "types": ["vite/client"]
  },
  "include": ["src"]
}
