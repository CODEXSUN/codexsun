{
  "name": "@codexsun/docs-api",
  "private": true,
  "version": "0.1.22",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --cache --cache-location ../../../node_modules/.cache/eslint/docs-api.eslintcache",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "start": "node ../../../dist/apps/docs/api/server.js"
  },
  "dependencies": {
    "@codexsun/docs-contracts": "file:../contracts",
    "@codexsun/platform-core-api": "^0.1.22",
    "@fastify/cors": "latest",
    "@mdx-js/mdx": "latest",
    "fastify": "^5.12.1",
    "gray-matter": "latest",
    "kysely": "^0.29.5",
    "mysql2": "^3.23.4",
    "react": "latest",
    "react-dom": "latest",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
