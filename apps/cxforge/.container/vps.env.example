CXFORGE_ZUNO_CLIENT_KEY=replace-with-a-32-character-secret
CXFORGE_SERVER_ID=replace-with-a-stable-uuid
CXFORGE_CONTAINER_NAME=replace-with-the-runtime-container-name
CXFORGE_VERSION=1.0.0
CXFORGE_EXECUTION_MODE=model
CXFORGE_MODEL_COMMAND=
OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
CXFORGE_OPENAI_MODEL=gpt-5.6-terra
CXFORGE_REASONING_EFFORT=high
CXFORGE_CREDENTIAL_ENCRYPTION_KEY_FILE=/run/secrets/credential_encryption_key
CXFORGE_TEST_COMMAND=git diff --check
CXFORGE_WORKSPACE_ROOT=/workspace
CXFORGE_SOURCE_ROOT=/repositories
CXFORGE_STATE_PATH=/workspace/.cxforge-state.json
CXFORGE_COMMAND_TIMEOUT=300
CXFORGE_MAX_WORKERS=2
CXFORGE_MAX_AGENT_TURNS=4
CXFORGE_ALLOW_REPO_COMMANDS=true
CXFORGE_PREVIEW_COMMAND=
CXFORGE_INPUT_PRICE_PER_MILLION=2
CXFORGE_OUTPUT_PRICE_PER_MILLION=12
CXFORGE_COST_ALERT_THRESHOLD_USD=10
CXFORGE_ALERT_WEBHOOK_URL=
CXFORGE_GITHUB_API_URL=https://api.github.com
