{
  "name": "codexsun",
  "version": "1.0.16",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "apps/*/api",
    "apps/*/web",
    "apps/*/desktop",
    "apps/*/mobile",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run clean:root-layout && turbo run build && npm run clean:root-layout && npm run check:root-layout",
    "check": "npm run clean:root-layout && npm run check:line-endings && npm run check:versions && turbo run check && npm run test:framework && npm run test:platform-core && npm run test:platform-api && npm run test:platform-web && npm run test:platform-desktop && npm run test:ui && npm run test:module-generator && npm run test:turbo-scope && npm run test:line-endings && npm run test:app-worktree && npm run check:module-boundaries && npm run test:module-boundaries && npm run check:app-architecture && npm run test:app-architecture && npm run lint && npm run clean:root-layout && npm run check:root-layout",
    "turbo:scope": "node tools/turbo-scope.mjs",
    "build:platform": "npm run turbo:scope -- platform build",
    "check:platform": "npm run turbo:scope -- platform check",
    "build:docs": "npm run turbo:scope -- docs build",
    "check:docs": "npm run turbo:scope -- docs check",
    "build:orship": "npm run turbo:scope -- orship build",
    "check:orship": "npm run turbo:scope -- orship check",
    "build:zetro": "npm run turbo:scope -- zetro build",
    "check:zetro": "npm run turbo:scope -- zetro check",
    "build:uiux": "npm run turbo:scope -- uiux build",
    "check:uiux": "npm run turbo:scope -- uiux check",
    "build:packages": "npm run turbo:scope -- packages build",
    "check:packages": "npm run turbo:scope -- packages check",
    "check:root-layout": "node tools/check-root-layout.mjs",
    "clean:root-layout": "node tools/clean-root-layout.mjs",
    "dev:api": "node tools/preflight.mjs platform-api",
    "dev:web": "node tools/preflight.mjs platform-web",
    "dev:uiux": "node tools/preflight.mjs uiux-web",
    "dev:zetro-api": "node tools/preflight.mjs zetro-api",
    "dev:zetro-web": "node tools/preflight.mjs zetro-web",
    "dev:docs-api": "node tools/preflight.mjs docs-api",
    "dev:docs-web": "node tools/preflight.mjs docs-web",
    "dev:desktop": "node tools/preflight.mjs platform-desktop",
    "preflight:api": "node tools/preflight.mjs platform-api --check",
    "preflight:web": "node tools/preflight.mjs platform-web --check",
    "preflight:uiux": "node tools/preflight.mjs uiux-web --check",
    "preflight:zetro-api": "node tools/preflight.mjs zetro-api --check",
    "preflight:zetro-web": "node tools/preflight.mjs zetro-web --check",
    "preflight:docs-api": "node tools/preflight.mjs docs-api --check",
    "preflight:docs-web": "node tools/preflight.mjs docs-web --check",
    "preflight:desktop": "node tools/preflight.mjs platform-desktop --check",
    "format": "prettier --write .",
    "lint": "eslint .",
    "version:bump": "node tools/version-bump.mjs",
    "check:versions": "node tools/check-versions.mjs",
    "check:line-endings": "node tools/line-endings.mjs check",
    "fix:line-endings": "node tools/line-endings.mjs fix",
    "github:now": "node tools/github-helper.mjs",
    "codexsun": "node tools/codexsun.mjs",
    "app:worktree": "node tools/codexsun.mjs app",
    "module:create": "node tools/create-module.mjs",
    "check:module-boundaries": "node tools/check-module-boundaries.mjs",
    "check:app-architecture": "node tools/check-app-architecture.mjs",
    "test:module-generator": "node --test tools/create-module.test.mjs",
    "test:turbo-scope": "node --test tools/turbo-scope.test.mjs",
    "test:module-boundaries": "node --test tools/check-module-boundaries.test.mjs",
    "test:app-architecture": "node --test tools/check-app-architecture.test.mjs",
    "test:versions": "node --test tools/version-bump.test.mjs",
    "test:line-endings": "node --test tools/line-endings.test.mjs",
    "test:app-worktree": "node --test tools/app-worktree.test.mjs",
    "test:framework": "npm run test --workspace @codexsun/framework",
    "test:platform-core": "npm run test --workspace @codexsun/platform-core",
    "test:platform-api": "npm run test --workspace @codexsun/platform-api",
    "test:platform-web": "npm run test --workspace @codexsun/platform-web",
    "test:ui": "npm run test --workspace @codexsun/ui",
    "test:zetro-api": "npm run test --workspace @codexsun/zetro-api",
    "test:zetro-web": "npm run test --workspace @codexsun/zetro-web",
    "test:docs-api": "npm run test --workspace @codexsun/docs-api",
    "test:docs-web": "npm run test --workspace @codexsun/docs-web",
    "test:platform-desktop": "npm run test --workspace @codexsun/platform-desktop",
    "test:platform-mobile": "npm run test --workspace @codexsun/platform-mobile",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0"
  }
}
