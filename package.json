{
  "name": "codexsun",
  "version": "1.0.32",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "apps/*/api",
    "apps/*/web",
    "apps/*/desktop",
    "apps/*/mobile",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test:framework && npm run test:platform-core && npm run test:platform-api && npm run test:platform-web && npm run test:ui && npm run test:zetro-api && npm run test:zetro-web && npm run test:platform-desktop && npm run test:platform-mobile && npm run test:cxforge && npm run test:zuno && npm run test:app-cli && npm run test:module-generator && npm run test:turbo-scope && npm run test:module-boundaries && npm run test:app-architecture && npm run test:versions && npm run test:line-endings && npm run test:app-worktree && npm run test:app-build",
    "github:now": "node tools/github-helper.mjs",
    "dev:api": "node tools/preflight.mjs platform-api --restart",
    "dev:web": "node tools/preflight.mjs platform-web --restart",
    "dev:all-api": "node tools/dev-all.mjs api",
    "dev:all-web": "node tools/dev-all.mjs web",
    "dev:uiux": "node tools/preflight.mjs uiux-web --restart",
    "dev:zetro-api": "node tools/preflight.mjs zetro-api --restart",
    "dev:zetro-web": "node tools/preflight.mjs zetro-web --restart",
    "dev:cxforge-api": "node tools/preflight.mjs cxforge-api --restart",
    "dev:zuno-api": "node tools/preflight.mjs zuno-api --restart",
    "dev:zuno-web": "node tools/preflight.mjs zuno-web --restart",
    "dev:zuno-desktop": "node tools/preflight.mjs zuno-desktop --restart",
    "dev:zuno-mobile": "node tools/preflight.mjs zuno-mobile --restart",
    "dev:desktop": "node tools/preflight.mjs platform-desktop --restart",
    "dev:mobile": "node tools/preflight.mjs platform-mobile --restart",
    "build": "npm run clean:root-layout && turbo run build && npm run clean:root-layout && node tools/check-root-layout.mjs",
    "turbo:scope": "node tools/turbo-scope.mjs",
    "build:platform": "npm run turbo:scope -- platform build",
    "build:zetro": "npm run turbo:scope -- zetro build",
    "build:uiux": "npm run turbo:scope -- uiux build",
    "build:packages": "npm run turbo:scope -- packages build",
    "app:build": "node packages/app-cli/src/main.mjs build",
    "app": "node packages/app-cli/src/main.mjs",
    "app:list": "node packages/app-cli/src/main.mjs list applications",
    "app:verify": "node packages/app-cli/src/main.mjs verify",
    "app:create": "node packages/app-cli/src/main.mjs create",
    "app:remove": "node packages/app-cli/src/main.mjs remove",
    "app:sync": "node packages/app-cli/src/main.mjs sync",
    "app:enable": "node packages/app-cli/src/main.mjs enable",
    "app:disable": "node packages/app-cli/src/main.mjs disable",
    "app:install": "node packages/app-cli/src/main.mjs install application",
    "app:uninstall": "node packages/app-cli/src/main.mjs uninstall application",
    "postinstall": "npm run clean:root-layout && node tools/check-root-layout.mjs",
    "addon:list": "node packages/app-cli/src/main.mjs list addons",
    "addon:create": "node packages/app-cli/src/main.mjs create-addon",
    "addon:enable": "node packages/app-cli/src/main.mjs enable addon",
    "addon:disable": "node packages/app-cli/src/main.mjs disable addon",
    "addon:install": "node packages/app-cli/src/main.mjs install addon",
    "addon:uninstall": "node packages/app-cli/src/main.mjs uninstall addon",
    "clean:root-layout": "node tools/clean-root-layout.mjs",
