{
  "name": "codexsun",
  "version": "1.0.17",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "apps/*/api",
    "apps/*/web",
    "apps/*/desktop",
    "apps/*/mobile",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run clean:root-layout && turbo run build && npm run clean:root-layout && node tools/check-root-layout.mjs",
    "turbo:scope": "node tools/turbo-scope.mjs",
    "build:platform": "npm run turbo:scope -- platform build",
    "build:docs": "npm run turbo:scope -- docs build",
    "build:orship": "npm run turbo:scope -- orship build",
    "build:zetro": "npm run turbo:scope -- zetro build",
    "build:uiux": "npm run turbo:scope -- uiux build",
    "build:packages": "npm run turbo:scope -- packages build",
    "clean:root-layout": "node tools/clean-root-layout.mjs",
    "dev:api": "node tools/preflight.mjs platform-api --restart",
    "dev:web": "node tools/preflight.mjs platform-web --restart",
    "dev:all-api": "node tools/dev-all.mjs api",
    "dev:all-web": "node tools/dev-all.mjs web",
    "dev:uiux": "node tools/preflight.mjs uiux-web --restart",
    "dev:zetro-api": "node tools/preflight.mjs zetro-api --restart",
    "dev:zetro-web": "node tools/preflight.mjs zetro-web --restart",
    "dev:orship-api": "node tools/preflight.mjs orship-api --restart",
    "dev:orship-web": "node tools/preflight.mjs orship-web --restart",
    "dev:docs-api": "node tools/preflight.mjs docs-api --restart",
    "dev:docs-web": "node tools/preflight.mjs docs-web --restart",
    "dev:desktop": "node tools/preflight.mjs platform-desktop --restart",
    "dev:mobile": "node tools/preflight.mjs platform-mobile --restart",
    "format": "prettier --write .",
    "lint": "eslint .",
    "version:bump": "node tools/version-bump.mjs",
    "platform:jwt-token": "tsx tools/platform-jwt-token.ts",
    "fix:line-endings": "node tools/line-endings.mjs fix",
    "github:now": "node tools/github-helper.mjs",
    "codexsun": "node tools/codexsun.mjs",
    "app:worktree": "node tools/codexsun.mjs app",
    "module:create": "node tools/create-module.mjs",
    "test:module-generator": "node --test tools/create-module.test.mjs",
    "test:turbo-scope": "node --test tools/turbo-scope.test.mjs",
    "test:module-boundaries": "node --test tools/check-module-boundaries.test.mjs",
    "test:app-architecture": "node --test tools/check-app-architecture.test.mjs",
    "test:versions": "node --test tools/version-bump.test.mjs",
    "test:line-endings": "node --test tools/line-endings.test.mjs",
    "test:app-worktree": "node --test tools/app-worktree.test.mjs",
    "test:framework": "npm run test --workspace @codexsun/framework",
    "test:platform-core": "npm run test --workspace @codexsun/platform-core",
    "test:platform-api": "npm run test --workspace @codexsun/platform-api",
    "test:platform-web": "npm run test --workspace @codexsun/platform-web",
    "test:ui": "npm run test --workspace @codexsun/ui",
    "test:zetro-api": "npm run test --workspace @codexsun/zetro-api",
    "test:zetro-web": "npm run test --workspace @codexsun/zetro-web",
    "test:docs-api": "npm run test --workspace @codexsun/docs-api",
    "test:docs-web": "npm run test --workspace @codexsun/docs-web",
    "test:platform-desktop": "npm run test --workspace @codexsun/platform-desktop",
    "test:platform-mobile": "npm run test --workspace @codexsun/platform-mobile",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.103.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "chalk": "^5.6.2",
    "eslint": "^9.0.0",
    "fastify-type-provider-zod": "^4.0.2",
    "globals": "^17.12.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "^9.2.4",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-highlight": "^3.30.5",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/extension-mention": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/extension-subscript": "^3.30.5",
    "@tiptap/extension-superscript": "^3.30.5",
    "@tiptap/extension-task-item": "^3.30.5",
    "@tiptap/extension-task-list": "^3.30.5",
    "@tiptap/extension-text-align": "^3.30.5",
    "@tiptap/extension-text-style": "^3.30.5",
    "@tiptap/extension-underline": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/suggestion": "^3.30.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.12",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.35.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-is": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  }
}
