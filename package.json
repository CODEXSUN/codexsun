    "format": "prettier --write .",
    "lint": "eslint .",
    "version:bump": "node tools/version-bump.mjs",
    "platform:jwt-token": "tsx tools/platform-jwt-token.ts",
    "identity:migrate": "tsx tools/identity-migrate.ts",
    "fix:line-endings": "node tools/line-endings.mjs fix",
    "codexsun": "node tools/codexsun.mjs",
    "app:worktree": "node tools/codexsun.mjs app",
    "module:create": "node tools/create-module.mjs",
    "test:module-generator": "node --test tools/create-module.test.mjs",
    "test:turbo-scope": "node --test tools/turbo-scope.test.mjs",
    "test:module-boundaries": "node --test tools/check-module-boundaries.test.mjs",
    "test:app-architecture": "node --test tools/check-app-architecture.test.mjs",
    "test:versions": "node --test tools/version-bump.test.mjs",
    "test:line-endings": "node --test tools/line-endings.test.mjs",
    "test:app-worktree": "node --test tools/app-worktree.test.mjs",
    "test:app-build": "node --test tools/app-build.test.mjs",
    "test:app-cli": "npm run test --workspace @codexsun/app-cli",
    "test:framework": "npm run test --workspace @codexsun/framework",
    "test:platform-core": "npm run test --workspace @codexsun/platform-core",
    "test:platform-mariadb": "npm run test:mariadb --workspace @codexsun/platform-core",
    "test:platform-api": "npm run test --workspace @codexsun/platform-api",
    "test:platform-web": "npm run test --workspace @codexsun/platform-web",
    "test:ui": "npm run test --workspace @codexsun/ui",
    "test:zetro-api": "npm run test --workspace @codexsun/zetro-api",
    "test:zetro-web": "npm run test --workspace @codexsun/zetro-web",
    "test:cxforge": "npm run test --workspace @codexsun/cxforge-api",
    "test:zuno": "npm run test --workspace @codexsun/zuno-api && npm run test --workspace @codexsun/zuno-web && npm run test --workspace @codexsun/zuno-desktop && npm run test --workspace @codexsun/zuno-mobile",
    "test:platform-desktop": "npm run test --workspace @codexsun/platform-desktop",
    "test:platform-mobile": "npm run test --workspace @codexsun/platform-mobile",
    "test:e2e": "playwright test",
    "dev:docx-api": "node tools/preflight.mjs docx-api --restart",
    "dev:docx-web": "node tools/preflight.mjs docx-web --restart",
    "test:docx": "npm run test --workspace @codexsun/docx-api && npm run test --workspace @codexsun/docx-web",
    "dev:qcafe-api": "node tools/preflight.mjs qcafe-api --restart",
    "dev:qcafe-web": "node tools/preflight.mjs qcafe-web --restart",
    "test:qcafe": "npm run test --workspace @codexsun/qcafe-api && npm run test --workspace @codexsun/qcafe-web",
    "dev:crm-api": "node tools/preflight.mjs crm-api --restart",
    "dev:crm-web": "node tools/preflight.mjs crm-web --restart",
    "test:crm": "npm run test --workspace @codexsun/crm-api && npm run test --workspace @codexsun/crm-web",
    "dev:himsx-api": "node tools/preflight.mjs himsx-api --restart",
    "dev:himsx-web": "node tools/preflight.mjs himsx-web --restart",
    "test:himsx": "npm run test --workspace @codexsun/himsx-api && npm run test --workspace @codexsun/himsx-web",
    "dev:lms-api": "node tools/preflight.mjs lms-api --restart",
    "dev:lms-web": "node tools/preflight.mjs lms-web --restart",
    "test:lms": "npm run test --workspace @codexsun/lms-api && npm run test --workspace @codexsun/lms-web",
    "dev:sites-api": "node tools/preflight.mjs sites-api --restart",
    "dev:sites-web": "node tools/preflight.mjs sites-web --restart",
    "test:sites": "npm run test --workspace @codexsun/sites-api && npm run test --workspace @codexsun/sites-web",
    "dev:orship-api": "node tools/preflight.mjs orship-api --restart",
    "dev:orship-web": "node tools/preflight.mjs orship-web --restart",
    "test:orship": "npm run test --workspace @codexsun/orship-api && npm run test --workspace @codexsun/orship-web"
  },
