FROM node:22-bookworm-slim AS builder

WORKDIR /workspace
COPY . .
RUN npm ci

ARG PROFILE_ID
ARG COMPONENT_ID
RUN npm run runtime:component -- ${PROFILE_ID} ${COMPONENT_ID}

FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production
ARG PROFILE_ID
ARG COMPONENT_ID
COPY --from=builder /workspace/dist/deployments/${PROFILE_ID}/components/${COMPONENT_ID}/root/ ./
RUN npm ci --omit=dev --ignore-scripts
RUN mkdir -p storage/app/private storage/app/public && chown -R node:node /app
USER node
CMD ["node", "start.mjs"]
