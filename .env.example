# Shared repository database. Use sqlite for local-only mode or mariadb for the shared server.
# DATABASE_URL may override these DB_* settings.
DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-a-local-password
DB_MASTER_NAME=codexsun_master_db
DATABASE_URL=
MARIADB_DATABASE=codexsun
MARIADB_USER=codexsun
MARIADB_PASSWORD=replace-with-a-local-password
MARIADB_ROOT_PASSWORD=replace-with-a-local-root-password
STORAGE_ROOT=../../../storage/apps
# Reserved for a future Redis-backed delivery provider. Database jobs do not use it yet.
REDIS_URL=redis://127.0.0.1:6379
PLATFORM_JWT_SECRET=replace-with-a-32-character-minimum-secret
PLATFORM_DEPLOYMENT_MODE=single
PLATFORM_DEPLOYMENT_NAME=aaran
PLATFORM_BOOTSTRAP_ADMIN_EMAIL=admin@admin.com
PLATFORM_DESKTOP_API_URL=http://127.0.0.1:6100
VITE_PLATFORM_DESKTOP_API_URL=http://127.0.0.1:6100
PLATFORM_MOBILE_API_URL=http://127.0.0.1:6100
# Shared remote-operations MCP. Set the token outside version control.
CODEXSUN_MCP_API_TOKEN=
CODEXSUN_MCP_REQUIRE_REQUEST_TOKEN=0
# Optional JSON values are configured only on the host that owns the SSH keys.
# CODEXSUN_MCP_SSH_TARGETS={"logicx":{"host":"logicx.ignorelist.com","user":"YOUR_LOGIN_USER","port":2122,"keyPath":"E:/codexsun/codexsun/storage/runtime/ssh/logicx_ed25519"}}
# CODEXSUN_MCP_SSH_ALLOWED_COMMANDS={"logicx":["docker compose ps","git status"]}
