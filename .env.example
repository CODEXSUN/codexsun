APP_ENV=development
CODEXSUN_VERSION=0.1.34
PLATFORM_API_HOST=127.0.0.1
PLATFORM_API_PORT=6010
PLATFORM_WEB_HOST=127.0.0.1
PLATFORM_WEB_PORT=6021
PLATFORM_WEB_ORIGIN=http://127.0.0.1:6021
ORSHIP_WEB_ORIGIN=http://127.0.0.1:6091
VITE_PLATFORM_API_URL=http://127.0.0.1:6010
UIUX_WEB_HOST=127.0.0.1
UIUX_WEB_PORT=6130
LOG_LEVEL=info
LOG_PRETTY=true
RUNTIME_LOG_MAX_BYTES=5242880
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_METRIC_EXPORT_INTERVAL=60000
SHUTDOWN_GRACE_MS=10000
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=1000

# === Database connection ===

DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_MASTER_NAME=

# === Database setup override ===

MARIADB_ADMIN_HOST=
MARIADB_ADMIN_PORT=
MARIADB_ADMIN_USER=
MARIADB_ADMIN_PASSWORD=
MARIADB_APPLICATION_HOST=localhost

# === Platform foundation ===

MODULE_RUNTIME_ENABLED=true
STORAGE_ROOT=storage/app

# === Identity ===

IDENTITY_AUTH_MODE=session
IDENTITY_DEV_LOGIN_ENABLED=false
IDENTITY_EMAIL_PROVIDER=disabled
IDENTITY_OTP_PROVIDER=disabled
IDENTITY_REGISTRATION_ENABLED=true
IDENTITY_SESSION_TTL_HOURS=168
IDENTITY_SESSION_RENEWAL_HOURS=24
IDENTITY_SUPER_ADMIN_NAME=Super Administrator
IDENTITY_SUPER_ADMIN_EMAIL=superadmin@localhost
IDENTITY_SUPER_ADMIN_PASSWORD=

# === Zetro ===

ZETRO_API_HOST=127.0.0.1
ZETRO_API_PORT=6050
ZETRO_DATABASE_PATH=storage/app/private/zetro/chat-v2.sqlite
ZETRO_CXZ_URL=http://127.0.0.1:6155
ZETRO_CXZ_ORIGIN=http://127.0.0.1:6155
ZETRO_WEB_HOST=127.0.0.1
ZETRO_WEB_PORT=6060
ZETRO_WEB_ORIGIN=http://127.0.0.1:6060
VITE_ZETRO_API_URL=http://127.0.0.1:6050

CXZ_HOST=0.0.0.0
CXZ_PORT=6155

# === Agent Crew ===

AGENT_CREW_API_HOST=127.0.0.1
AGENT_CREW_API_PORT=6100
AGENT_CREW_WEB_HOST=127.0.0.1
AGENT_CREW_WEB_PORT=6110
AGENT_CREW_RUNNER_PORT=6120
AGENT_CREW_WORKER_URL=http://127.0.0.1:6120
AGENT_CREW_ALLOWED_ORIGINS=http://127.0.0.1:6110
AGENT_CREW_RUNNER_TOKEN=local-agent-crew-token
AGENT_CREW_OLLAMA_URL=http://host.docker.internal:11434
AGENT_CREW_WORKSPACE_ROOT=/workspaces
OPENCODE_MODEL=opencode/nemotron-3.5-lightning-free

# === Docs ===

DOCS_VAULT_PATH=apps/docs/content
DOCS_INDEX_MODE=hybrid
DOCS_API_PORT=6030
DOCS_WEB_PORT=6040
VITE_DOCS_API_URL=http://127.0.0.1:6030

# === DevKit ===

DEVKIT_API_HOST=127.0.0.1
DEVKIT_API_PORT=6070
DEVKIT_WEB_PORT=6080
VITE_DEVKIT_API_URL=http://127.0.0.1:6070
DEVKIT_REGISTRY_PATH=storage/app/private/devkit/project-registry.json

# === Orship ===

ORSHIP_API_HOST=127.0.0.1
ORSHIP_API_PORT=6090
ORSHIP_WEB_HOST=127.0.0.1
ORSHIP_WEB_PORT=6091
ORSHIP_CONTROL_ENABLED=true
VITE_ORSHIP_API_URL=http://127.0.0.1:6090
VITE_AUTO_LOGIN=0

# === Shared prerequisites ===

PREREQUISITE_MARIADB_PORT=3307
PREREQUISITE_MARIADB_ROOT_PASSWORD=
PREREQUISITE_REDIS_PORT=6379
PREREQUISITE_REDIS_PASSWORD=
PREREQUISITE_FILEBROWSER_PORT=7090
PREREQUISITE_FILEBROWSER_ADMIN_USER=admin
PREREQUISITE_FILEBROWSER_ADMIN_PASSWORD=
