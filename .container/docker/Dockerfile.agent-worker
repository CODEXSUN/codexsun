# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS builder
WORKDIR /workspace
COPY . .
RUN --mount=type=cache,target=/root/.npm npm install --global npm@12.0.2 --no-audit --no-fund && npm ci --no-audit --no-fund
ARG PROFILE_ID
ARG COMPONENT_ID
RUN npm run runtime:component -- ${PROFILE_ID} ${COMPONENT_ID}

FROM node:22-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends python3 git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production PATH=/opt/agent-tools/node_modules/.bin:$PATH HOME=/app/storage/app/private/agent-crew/credentials CODEX_HOME=/app/storage/app/private/agent-crew/credentials/codex XDG_CONFIG_HOME=/app/storage/app/private/agent-crew/credentials/opencode XDG_DATA_HOME=/app/storage/app/private/agent-crew/credentials/opencode
RUN mkdir -p /opt/agent-tools && cd /opt/agent-tools && npm init -y && npm install --omit=dev --save-exact @openai/codex@0.153.2 opencode-ai@1.18.30
ARG PROFILE_ID
ARG COMPONENT_ID
COPY --from=builder /workspace/dist/deployments/${PROFILE_ID}/components/${COMPONENT_ID}/root/ ./
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev --ignore-scripts --no-audit --no-fund && mkdir -p storage/app/private storage/app/public /workspaces && chown -R node:node /app /workspaces
USER node
CMD ["node", "start.mjs"]
