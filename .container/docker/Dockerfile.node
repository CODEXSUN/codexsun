# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS builder

WORKDIR /workspace
COPY . .
RUN --mount=type=cache,target=/root/.npm \
  npm install --global npm@12.0.2 --no-audit --no-fund \
  && test "$(npm --version)" = "12.0.2" \
  && npm ci --no-audit --no-fund

ARG PROFILE_ID
ARG COMPONENT_ID
RUN npm run runtime:component -- ${PROFILE_ID} ${COMPONENT_ID}

FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production
ARG PROFILE_ID
ARG COMPONENT_ID
COPY --from=builder /workspace/dist/deployments/${PROFILE_ID}/components/${COMPONENT_ID}/root/ ./
RUN --mount=type=cache,target=/root/.npm \
  npm ci --omit=dev --ignore-scripts --no-audit --no-fund
RUN mkdir -p storage/app/private storage/app/public \
  && chown -R node:node storage
USER node
CMD ["node", "start.mjs"]
