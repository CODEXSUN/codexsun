# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS builder

WORKDIR /workspace
COPY . .
RUN --mount=type=cache,id=codexsun-agent-crew-worker-npm,target=/root/.npm,sharing=locked \
  npm ci --no-audit --no-fund

ARG PROFILE_ID
ARG COMPONENT_ID
RUN npm run runtime:component -- ${PROFILE_ID} ${COMPONENT_ID}

FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ARG PROFILE_ID
ARG COMPONENT_ID
COPY --from=builder /workspace/dist/deployments/${PROFILE_ID}/components/${COMPONENT_ID}/root/ ./
RUN --mount=type=cache,id=codexsun-agent-crew-api-runtime-npm,target=/root/.npm,sharing=locked \
  npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
  && mkdir -p storage/app/private storage/app/public \
  && chown -R node:node /app
USER node
CMD ["node", "start.mjs"]
