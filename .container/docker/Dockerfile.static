# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS builder

WORKDIR /workspace
RUN npm install --global npm@12.0.2 --no-audit --no-fund \
  && test "$(npm --version)" = "12.0.2"
COPY . .
RUN --mount=type=cache,id=codexsun-orship-static-npm,target=/root/.npm,sharing=locked npm ci --no-audit --no-fund

ARG PROFILE_ID
ARG COMPONENT_ID
RUN npm run runtime:component -- ${PROFILE_ID} ${COMPONENT_ID}

FROM nginx:1.29-alpine AS runtime

ARG PROFILE_ID
ARG COMPONENT_ID
COPY .container/docker/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=builder /workspace/dist/deployments/${PROFILE_ID}/components/${COMPONENT_ID}/public/ /usr/share/nginx/html/
