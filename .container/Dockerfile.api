FROM node:24-alpine AS build
WORKDIR /workspace
COPY package.json package-lock.json turbo.json tsconfig.base.json eslint.config.mjs ./
COPY .env.example .env
COPY apps ./apps
COPY packages ./packages
COPY tools ./tools
RUN npm ci
RUN npm run build --workspace @codexsun/platform-api

FROM node:24-alpine
WORKDIR /workspace
ENV NODE_ENV=production
COPY --from=build /workspace/dist/platform/api ./dist/platform/api
EXPOSE 6100
CMD ["node", "dist/platform/api/server.js"]
