{
  "schemaVersion": 1,
  "kind": "application",
  "id": "zuno",
  "label": "Zuno",
  "owner": "apps/zuno",
  "taskPrefix": "n",
  "providers": [
    "platform.core",
    "zuno.foundation",
    "zuno.handoff"
  ],
  "mdi": {
    "icon": "application",
    "localUrlKey": "VITE_ZUNO_WEB_URL",
    "path": "/"
  },
  "hosts": [
    {
      "kind": "api",
      "target": "zuno-api",
      "displayName": "Zuno API",
      "environmentDirectory": "api",
      "envKey": "ZUNO_API_PORT",
      "workspace": "@codexsun/zuno-api",
      "defaultPort": 6410
    },
    {
      "kind": "web",
      "target": "zuno-web",
      "displayName": "Zuno web",
      "environmentDirectory": "web",
      "envKey": "ZUNO_WEB_PORT",
      "workspace": "@codexsun/zuno-web",
      "defaultPort": 6411
    },
    {
      "kind": "desktop",
      "target": "zuno-desktop",
      "displayName": "Zuno desktop",
      "environmentDirectory": "desktop",
      "envKey": "ZUNO_DESKTOP_PORT",
      "workspace": "@codexsun/zuno-desktop",
      "defaultPort": 6413
    },
    {
      "kind": "mobile",
      "target": "zuno-mobile",
      "displayName": "Zuno mobile",
      "environmentDirectory": "mobile",
      "envKey": "ZUNO_MOBILE_PORT",
      "workspace": "@codexsun/zuno-mobile",
      "defaultPort": 6414
    }
  ]
}
