{
  "schemaVersion": 1,
  "kind": "application",
  "id": "orship",
  "label": "Orship",
  "owner": "apps/orship",
  "taskPrefix": "o",
  "providers": [
    "platform.core",
    "orship.foundation",
    "orship.infras"
  ],
  "mdi": {
    "icon": "application",
    "localUrlKey": "VITE_ORSHIP_WEB_URL",
    "path": "/"
  },
  "hosts": [
    {
      "kind": "api",
      "target": "orship-api",
      "displayName": "Orship API",
      "environmentDirectory": "api",
      "envKey": "ORSHIP_API_PORT",
      "workspace": "@codexsun/orship-api",
      "defaultPort": 6300
    },
    {
      "kind": "web",
      "target": "orship-web",
      "displayName": "Orship web",
      "environmentDirectory": "web",
      "envKey": "ORSHIP_WEB_PORT",
      "workspace": "@codexsun/orship-web",
      "defaultPort": 6301
    }
  ]
}
