{
  "kind": "application",
  "schemaVersion": 1,
  "id": "docs",
  "label": "Docs",
  "taskPrefix": "d",
  "mdi": { "icon": "docs", "localUrlKey": "VITE_DOCS_WEB_URL", "path": "/" },
  "providers": ["platform.core", "docs.catalog"],
  "hosts": [
    { "kind": "api", "target": "docs-api", "displayName": "Docs API", "environmentDirectory": "api", "envKey": "DOCS_API_PORT", "workspace": "@codexsun/docs-api" },
    { "kind": "web", "target": "docs-web", "displayName": "Docs web", "environmentDirectory": "web", "envKey": "DOCS_WEB_PORT", "workspace": "@codexsun/docs-web" }
  ]
}
